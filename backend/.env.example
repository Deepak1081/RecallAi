# RecallAI Backend Environment Configuration
PORT=5000

# Active AI Provider: "groq" or "gemini"
# If GROQ_API_KEY is set, RecallAI automatically uses Groq for ultra-fast generation
AI_PROVIDER=groq

# Groq API Key from Groq Console (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Recommended models: openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
